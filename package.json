{
  "name": "dsh-pi",
  "version": "0.2.0",
  "type": "module",
  "description": "把 pi 编码代理接进 DSH：侧栏「pi」整页聊天面板，底层是常驻的 pi --mode rpc 子进程。pi runtime is resolved from the plugin itself (.runtime), so the panel works on any machine without a hand-written path.",
  "icon": "./assets/icon.svg",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "src",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/selfcheck.mjs && node test/client-render.mjs && node test/runtime-resolve.mjs",
    "test:client": "node test/client-render.mjs",
    "test:host": "node test/host-smoke.mjs",
    "test:runtime": "node test/runtime-resolve.mjs",
    "test:fresh": "node test/fresh-boot.mjs",
    "test:all": "node test/selfcheck.mjs && node test/client-render.mjs && node test/runtime-resolve.mjs && node test/host-smoke.mjs",
    "verify": "pwsh -NoProfile -File ./tools/verify-packed.ps1",
    "pack": "npm pack"
  },
  "engines": {
    "node": ">=22.5"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "pi",
    "coding-agent",
    "deepseek-runtime"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lwaaron/pi.git"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "optionalDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.2"
  }
}
