{
  "name": "superpi",
  "version": "0.35.0",
  "type": "module",
  "description": "SuperPi 编码助手，支持 DSH 聊天面板与命令行，复用 Pi 的运行时和 JSONL RPC 协议。",
  "icon": "./assets/icon.svg",
  "main": "./index.js",
  "bin": {
    "superpi": "./src/superpi-cli.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "src",
    "extensions",
    "skills",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/preflight.mjs && node tools/check-carriers.mjs && node test/selfcheck.mjs && node test/client-render.mjs && node test/css-tokens.mjs && node test/runtime-resolve.mjs && node test/config-hot.mjs && node test/host-parity.mjs && node test/session-projects.mjs && node test/session-lifecycle.mjs && node test/timeout.mjs && node test/rules.mjs && node test/context-guard.mjs && node test/modalities.mjs && node test/turn-verdict.mjs && node test/text-integrity.mjs && node test/delivery.mjs && node test/reliability.mjs && node test/engineering-bench.mjs && node test/parity.mjs && node test/tui-editor.mjs && node test/brand-pi-runtime.mjs && node test/restart-lib.mjs && node test/github-sync.mjs && node test/version.mjs && node test/gate-inventory.mjs",
    "test:preflight": "node test/preflight.mjs",
    "test:inventory": "node test/gate-inventory.mjs",
    "test:lifecycle": "node test/session-lifecycle.mjs",
    "test:client": "node test/client-render.mjs",
    "test:host": "node test/host-smoke.mjs && node test/write-limit-e2e.mjs",
    "test:runtime": "node test/runtime-resolve.mjs",
    "test:config": "node test/config-hot.mjs",
    "test:version": "node test/version.mjs",
    "test:fresh": "node test/fresh-boot.mjs",
    "test:parity": "node test/parity.mjs",
    "test:host-parity": "node test/host-parity.mjs",
    "test:projects": "node test/session-projects.mjs",
    "test:timeout": "node test/timeout.mjs",
    "test:rules": "node test/rules.mjs",
    "test:tui": "node test/tui-editor.mjs",
    "test:restart": "node test/restart-lib.mjs",
    "test:github": "node test/github-sync.mjs",
    "sync": "node tools/github-sync.mjs",
    "sync:status": "node tools/github-sync.mjs --status",
    "hooks": "node tools/github-sync.mjs --install-hooks",
    "superpi:editor": "node tools/install-pi-extension.mjs --install",
    "superpi:editor:status": "node tools/install-pi-extension.mjs",
    "superpi:editor:remove": "node tools/install-pi-extension.mjs --remove",
    "pi:editor": "npm run superpi:editor --",
    "pi:editor:status": "npm run superpi:editor:status --",
    "pi:editor:remove": "npm run superpi:editor:remove --",
    "test:all": "npm test && npm run test:host",
    "verify": "pwsh -NoProfile -File ./tools/verify-packed.ps1",
    "pack": "npm pack",
    "test:brand": "node test/brand-pi-runtime.mjs",
    "superpi:brand": "node tools/brand-pi-runtime.mjs --apply --all-profiles",
    "superpi:brand:status": "node tools/brand-pi-runtime.mjs",
    "superpi:brand:revert": "node tools/brand-pi-runtime.mjs --revert --all-profiles",
    "pi:brand": "npm run superpi:brand --",
    "pi:brand:status": "npm run superpi:brand:status --",
    "pi:brand:revert": "npm run superpi:brand:revert --",
    "test:guard": "node test/context-guard.mjs",
    "test:modalities": "node test/modalities.mjs",
    "check:carriers": "node tools/check-carriers.mjs",
    "check:carriers:fix": "node tools/check-carriers.mjs --fix",
    "test:verdict": "node test/turn-verdict.mjs",
    "test:integrity": "node test/text-integrity.mjs",
    "test:reliability": "node test/reliability.mjs",
    "test:delivery": "node test/delivery.mjs",
    "test:engineering": "node test/engineering-bench.mjs"
  },
  "engines": {
    "node": ">=22.5"
  },
  "keywords": [
    "superpi",
    "dsh",
    "dsh-plugin",
    "pi",
    "coding-agent",
    "deepseek-runtime"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lwaaron/superpi.git"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "optionalDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2"
  }
}
